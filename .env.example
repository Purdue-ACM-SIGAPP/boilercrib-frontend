# Copy to .env (cp .env.example .env). Required: the app reads API_BASE_URL at build time.
# iOS Simulator / web: http://localhost:5128
# Android emulator:    http://10.0.2.2:5128
# Phone with Expo Go:  http://<your computer's LAN IP>:5128
API_BASE_URL=http://localhost:5128

# Native map builds only (iOS/Android)
GOOGLE_MAPS_API_KEY=
